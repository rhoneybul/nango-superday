// Prisma 7: engine-free client. The datasource URL lives in prisma.config.ts
// (used by the CLI for migrations); the runtime connects via @prisma/adapter-pg
// using the URL from the config package.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Event {
  id        BigInt   @id @default(autoincrement())
  accountId String   @map("account_id")
  /// Client-supplied idempotency key (or a UUID the API generated). Unique per account: a redelivered or retried event is stored once.
  eventId   String   @map("event_id")
  eventName String   @map("event_name")
  /// Free-form context for billing or debugging (connection id, provider, model, …).
  metadata  Json?
  timestamp DateTime @default(now()) @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Composite indexes covering the query patterns of GET /events:
  //   account + time range, account + event + time range, event + time range.
  @@index([accountId, timestamp])
  @@index([accountId, eventName, timestamp])
  @@index([eventName, timestamp])
  @@unique([accountId, eventId])
  @@map("events")
}

// Seeded tenants (src/models/seeded-accounts.ts, applied by `npm run seed`).
// Every account_id on POST /ingest and the GET /events `account` filter must
// exist here; lookups are cached in Redis (src/services/account.service.ts).
model Account {
  id        String   @id
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("accounts")
}
