            "type": "yesoreyeram-infinity-datasource",
            "uid": "metering-api"
          },
          "type": "json",
          "source": "url",
          "format": "table",
          "parser": "backend",
          "url": "http://api:3000/events?window=${window}&from=${__from:date:iso}&to=${__to:date:iso}",
          "url_options": {
            "method": "GET",
            "data": ""
