{
  "uid": "nango-events",
  "title": "Events",
  "tags": [
    "nango",
    "events"
  ],
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "10s",
  "timezone": "browser",
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Events per minute by name",
      "type": "timeseries",
      "datasource": {
        "type": "postgres",
        "uid": "postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 16,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "postgres"
          },
          "refId": "A",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(\"timestamp\", '1m'), event_name AS metric, count(*) AS value\nFROM events\nWHERE $__timeFilter(\"timestamp\")\nGROUP BY 1, 2\nORDER BY 1",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "title": "Events by name (range)",
      "type": "piechart",
      "datasource": {
        "type": "postgres",
        "uid": "postgres"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "postgres"
          },
          "refId": "A",
          "rawQuery": true,
          "rawSql": "SELECT event_name AS metric, count(*) AS value\nFROM events\nWHERE $__timeFilter(\"timestamp\")\nGROUP BY 1\nORDER BY 2 DESC",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "title": "Total events (range)",
      "type": "stat",
      "datasource": {
        "type": "postgres",
        "uid": "postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "postgres"
          },
          "refId": "A",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS events FROM events WHERE $__timeFilter(\"timestamp\")",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "title": "Active accounts (range)",
      "type": "stat",
      "datasource": {
        "type": "postgres",
        "uid": "postgres"
      },
      "gridPos": {
        "x": 6,
        "y": 9,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "postgres"
          },
          "refId": "A",
          "rawQuery": true,
          "rawSql": "SELECT count(DISTINCT account_id) AS accounts FROM events WHERE $__timeFilter(\"timestamp\")",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "title": "Top accounts (range)",
      "type": "table",
      "datasource": {
        "type": "postgres",
        "uid": "postgres"
      },
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "postgres"
          },
          "refId": "A",
          "rawQuery": true,
          "rawSql": "SELECT account_id, count(*) AS events\nFROM events\nWHERE $__timeFilter(\"timestamp\")\nGROUP BY 1\nORDER BY 2 DESC\nLIMIT 10",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "title": "Latest events",
      "type": "table",
      "datasource": {
        "type": "postgres",
        "uid": "postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "postgres"
          },
          "refId": "A",
          "rawQuery": true,
          "rawSql": "SELECT \"timestamp\", account_id, event_name, id\nFROM events\nWHERE $__timeFilter(\"timestamp\")\nORDER BY \"timestamp\" DESC\nLIMIT 50",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    }
  ]
}
