        {
          "name": "Batch with some valid and some failing events (partial success)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 202: something was queued\", () => pm.response.to.have.status(202));",
                  "pm.test(\"2 queued, 3 failed\", () => { const d = pm.response.json().data; pm.expect(d.queued).to.eql(2); pm.expect(d.failed).to.eql(3); });",
                  "pm.test(\"each failure names the event index and the reason\", () => { const e = pm.response.json().data.errors; pm.expect(e.map(x => [x.index, x.reason])).to.eql([[1, \"invalid\"], [3, \"invalid\"], [4, \"unknown_account\"]]); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ingest/batch",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ingest",
                "batch"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"events\": [\n    {\n      \"account_id\": \"{{accountId}}\",\n      \"event_name\": \"sync_run\",\n      \"timestamp\": \"{{nowIso}}\"\n    },\n    {\n      \"account_id\": \"{{accountId}}\",\n      \"event_name\": \"page_view\",\n      \"timestamp\": \"{{nowIso}}\"\n    },\n    {\n      \"account_id\": \"{{accountId}}\",\n      \"event_name\": \"records_synced\",\n      \"timestamp\": \"{{nowIso}}\"\n    },\n    {\n      \"account_id\": \"{{accountId}}\",\n      \"event_name\": \"api_request\"\n    },\n    {\n      \"account_id\": \"acc_unknown\",\n      \"event_name\": \"api_request\",\n      \"timestamp\": \"{{nowIso}}\"\n    }\n  ]\n}"
