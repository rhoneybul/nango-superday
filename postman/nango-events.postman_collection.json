    {
      "name": "Ingest - rate limit",
      "description": "The limit is INGEST_RATE_LIMIT_PER_MINUTE (default 100) per account_id:event_name.",
      "item": [
        {
          "name": "Rate limit (run 101 times)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"rate limit headers present\", () => pm.expect(pm.response.headers.has(\"RateLimit-Limit\")).to.be.true);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ingest",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ingest"
              ]
            },
            "description": "Run this with the Collection Runner set to 101 iterations: the first 100 return 201, the 101st returns 429 with RateLimit-* headers. Uses its own account so it never blocks the other requests.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"account_id\": \"ratelimit_acc\",\n  \"event_name\": \"logout\"\n}"
            }
          }
        },
        {
          "name": "Other event for the same account still accepted",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ingest",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ingest"
              ]
            },
            "description": "Send after the request above has hit 429: the limit is per account_id + event_name, so a different event name is still served.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"account_id\": \"ratelimit_acc\",\n  \"event_name\": \"signup\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Query events",
      "description": "",
      "item": [
        {
          "name": "Events for account (newest first)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"has data and meta\", () => { const b = pm.response.json(); pm.expect(b.data).to.be.an(\"array\"); pm.expect(b.meta).to.have.keys(\"total\", \"limit\", \"offset\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/events?account={{accountId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events"
              ],
              "query": [
                {
                  "key": "account",
                  "value": "{{accountId}}"
                }
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Events for account + event name in a date range",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"echoes filters\", () => pm.expect(pm.response.json().filters).to.eql({ account: pm.variables.get(\"accountId\"), event: \"purchase\", from: \"2026-09-01T00:00:00.000Z\", to: \"2026-09-02T00:00:00.000Z\" }));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/events?account={{accountId}}&event=purchase&from=2026-09-01T00:00:00Z&to=2026-09-02T00:00:00Z",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events"
              ],
              "query": [
                {
                  "key": "account",
                  "value": "{{accountId}}"
                },
                {
                  "key": "event",
                  "value": "purchase"
                },
                {
                  "key": "from",
                  "value": "2026-09-01T00:00:00Z"
                },
                {
                  "key": "to",
                  "value": "2026-09-02T00:00:00Z"
                }
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Counts per hour (window=1h)",
