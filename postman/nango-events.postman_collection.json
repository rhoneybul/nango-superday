  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Dates are computed per request so the demo queries always cover today's events.",
          "const now = new Date();",
          "const start = new Date(now); start.setUTCHours(0, 0, 0, 0);",
          "const end = new Date(start.getTime() + 24 * 3600 * 1000);",
          "pm.variables.set('nowIso', now.toISOString());",
          "pm.variables.set('nowMs', String(now.getTime()));",
          "pm.variables.set('todayStart', start.toISOString());",
          "pm.variables.set('todayEnd', end.toISOString());"
        ]
      }
    }
  ]
