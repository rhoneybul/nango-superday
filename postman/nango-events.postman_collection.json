    {
      "name": "Ingest - rate limit",
      "description": "The limit is INGEST_RATE_LIMIT_PER_MINUTE (default 100) per account_id:event_name. Uses the seeded account acc_umbrella so it never blocks the other requests.",
      "item": [
        {
          "name": "Rate limit (run 101 times)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 202\", () => pm.response.to.have.status(202));",
                  "pm.test(\"rate limit headers present\", () => pm.expect(pm.response.headers.has(\"RateLimit-Limit\")).to.be.true);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ingest",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ingest"
              ]
            },
            "description": "Run this with the Collection Runner set to 101 iterations: the first 100 return 202, the 101st returns 429 with RateLimit-* headers. Uses the seeded account acc_umbrella (Umbrella Corp) so it never blocks the other requests.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"account_id\": \"acc_umbrella\",\n  \"event_name\": \"logout\"\n}"
            }
          }
        },
        {
          "name": "Other event for the same account still accepted",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 202\", () => pm.response.to.have.status(202));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ingest",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ingest"
              ]
            },
            "description": "Send after the request above has hit 429: the limit is per account_id + event_name, so a different event name is still served.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"account_id\": \"acc_umbrella\",\n  \"event_name\": \"signup\"\n}"
            }
          }
        }
      ]
    },
