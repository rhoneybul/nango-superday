{
  "info": {
    "name": "nango-events",
    "description": "Requests that exercise every path of the events API: valid ingests, each kind of invalid input, unknown accounts (404), the per account_id:event_name rate limit, the query endpoint and the Prometheus metrics. account_id values must be seeded accounts (src/models/seeded-accounts.ts); the accountId variable defaults to acc_acme. Each request asserts its expected status code, so the whole collection can be run with the Collection Runner or newman.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "accountId",
      "value": "acc_acme"
    },
    {
      "key": "nextCursor",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"status ok\", () => pm.expect(pm.response.json().status).to.eql(\"ok\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        },
        "description": ""
      }
    },
    {
      "name": "Metrics",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"prometheus text format\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"text/plain\"));",
              "pm.test(\"exposes the rate-limit metrics\", () => pm.expect(pm.response.text()).to.include(\"ingest_rate_limited_total\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/metrics",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "metrics"
          ]
        },
        "description": "Prometheus exposition scraped by the prometheus compose service. Rate-limit series (ingest_rate_limited_total, ingest_rate_limited_last_seen_timestamp_seconds) appear once something has been rate limited."
      }
    },
    {
