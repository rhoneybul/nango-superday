{
  "info": {
    "name": "nango-events",
    "description": "Metering API. Ingest single events or batches (queued, 202), see them rejected when invalid, and query them raw or aggregated per time bucket. Events carry optional metadata for billing. Timestamps and query ranges are computed per request (collection pre-request script) so the queries always cover today. Set `baseUrl` if the API is not on localhost:3000; `accountId` must be a seeded account.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "accountId",
      "value": "acc_acme"
    }
  ],
  "item": [
    {
      "name": "Ingest",
      "description": "POST /ingest: one event. Answers 202 once the event is on the queue; the consumer writes it to Postgres a moment later.",
      "item": [
        {
          "name": "Connection created (timestamp defaults to now)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 202\", () => pm.response.to.have.status(202));",
                  "pm.test(\"queued with the metadata\", () => { const d = pm.response.json().data; pm.expect(d.eventName).to.eql(\"connection_created\"); pm.expect(d.metadata.provider).to.eql(\"hubspot\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ingest",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ingest"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"account_id\": \"{{accountId}}\",\n  \"event_name\": \"connection_created\",\n  \"metadata\": {\n    \"connection_id\": \"conn_42\",\n    \"provider\": \"hubspot\"\n  }\n}"
            },
            "description": ""
          }
        },
        {
          "name": "Records synced (metadata with the record count)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 202\", () => pm.response.to.have.status(202));",
                  "pm.test(\"metadata kept\", () => pm.expect(pm.response.json().data.metadata.records).to.eql(250));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ingest",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ingest"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"account_id\": \"{{accountId}}\",\n  \"event_name\": \"records_synced\",\n  \"timestamp\": \"{{nowIso}}\",\n  \"metadata\": {\n    \"connection_id\": \"conn_42\",\n    \"provider\": \"hubspot\",\n    \"model\": \"Contact\",\n    \"records\": 250\n  }\n}"
            },
            "description": ""
          }
        },
        {
          "name": "API request (epoch milliseconds timestamp)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 202\", () => pm.response.to.have.status(202));",
                  "pm.test(\"epoch ms is accepted\", () => pm.expect(new Date(pm.response.json().data.timestamp).getTime()).to.be.above(Date.now() - 60000));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ingest",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ingest"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"account_id\": \"{{accountId}}\",\n  \"event_name\": \"api_request\",\n  \"timestamp\": {{nowMs}},\n  \"metadata\": {\n    \"provider\": \"salesforce\",\n    \"endpoint\": \"/services/data/v60.0/query\"\n  }\n}"
            },
            "description": ""
          }
        }
      ]
    },
    {
      "name": "Batch",
      "description": "POST /ingest/batch: up to 100 events in one request, each with a required timestamp. Valid events are queued; the response says how many (`queued`) and lists every event that was not, with its index and why (`errors`). 202 if anything was queued, 400/429 if nothing was. 10 batches per account per minute.",
      "item": [
        {
          "name": "Batch of 3 (one account, mixed usage)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 202\", () => pm.response.to.have.status(202));",
                  "pm.test(\"all 3 queued, none failed\", () => pm.expect(pm.response.json().data).to.eql({ queued: 3, failed: 0, errors: [] }));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ingest/batch",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ingest",
                "batch"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"events\": [\n    {\n      \"account_id\": \"{{accountId}}\",\n      \"event_name\": \"sync_run\",\n      \"timestamp\": \"{{nowIso}}\",\n      \"metadata\": {\n        \"connection_id\": \"conn_42\",\n        \"sync\": \"contacts\"\n      }\n    },\n    {\n      \"account_id\": \"{{accountId}}\",\n      \"event_name\": \"records_synced\",\n      \"timestamp\": \"{{nowIso}}\",\n      \"metadata\": {\n        \"connection_id\": \"conn_42\",\n        \"model\": \"Contact\"\n      }\n    },\n    {\n      \"account_id\": \"{{accountId}}\",\n      \"event_name\": \"api_request\",\n      \"timestamp\": \"{{nowIso}}\"\n    }\n  ]\n}"
