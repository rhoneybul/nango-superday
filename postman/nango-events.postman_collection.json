{
  "info": {
    "name": "nango-events",
    "description": "Metering API. Ingest single events or batches (queued, 202), see them rejected when invalid, and query them raw or aggregated. Set `baseUrl` if the API is not on localhost:3000; `accountId` must be a seeded account (acc_acme, acc_globex, acc_initech, acc_umbrella, acc_hooli).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "accountId",
      "value": "acc_acme"
    }
  ],
  "item": [
    {
      "name": "Ingest",
      "description": "POST /ingest: one event. Answers 202 once the event is on the queue; the consumer writes it to Postgres a moment later.",
      "item": [
        {
          "name": "Signup (timestamp defaults to now)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 202\", () => pm.response.to.have.status(202));",
                  "pm.test(\"queued with a server timestamp\", () => { const d = pm.response.json().data; pm.expect(d.eventName).to.eql(\"signup\"); pm.expect(d.timestamp).to.be.a(\"string\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ingest",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ingest"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"account_id\": \"{{accountId}}\",\n  \"event_name\": \"signup\"\n}"
            },
            "description": ""
          }
        },
        {
          "name": "Purchase (explicit timestamp)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 202\", () => pm.response.to.have.status(202));",
                  "pm.test(\"keeps the supplied timestamp\", () => pm.expect(pm.response.json().data.timestamp).to.eql(\"2026-09-01T10:15:00.000Z\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ingest",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ingest"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"account_id\": \"{{accountId}}\",\n  \"event_name\": \"purchase\",\n  \"timestamp\": \"2026-09-01T10:15:00Z\"\n}"
            },
            "description": ""
          }
        },
        {
          "name": "Login (epoch milliseconds timestamp)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 202\", () => pm.response.to.have.status(202));",
                  "pm.test(\"epoch ms is accepted\", () => pm.expect(pm.response.json().data.timestamp).to.eql(\"2026-09-01T10:15:00.000Z\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ingest",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ingest"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"account_id\": \"{{accountId}}\",\n  \"event_name\": \"login\",\n  \"timestamp\": 1788257700000\n}"
            },
            "description": ""
          }
        }
      ]
    },
    {
      "name": "Batch",
      "description": "POST /ingest/batch: up to 100 events in one request, each with a required timestamp. Accepted or rejected as a whole; 10 batches per account per minute.",
      "item": [
        {
          "name": "Batch of 3 (one account)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 202\", () => pm.response.to.have.status(202));",
                  "pm.test(\"3 queued\", () => pm.expect(pm.response.json().data).to.eql({ queued: 3 }));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ingest/batch",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ingest",
                "batch"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"events\": [\n    {\n      \"account_id\": \"{{accountId}}\",\n      \"event_name\": \"signup\",\n      \"timestamp\": \"2026-09-01T10:00:00Z\"\n    },\n    {\n      \"account_id\": \"{{accountId}}\",\n      \"event_name\": \"login\",\n      \"timestamp\": \"2026-09-01T10:05:00Z\"\n    },\n    {\n      \"account_id\": \"{{accountId}}\",\n      \"event_name\": \"purchase\",\n      \"timestamp\": \"2026-09-01T10:10:00Z\"\n    }\n  ]\n}"
            },
            "description": ""
          }
        },
        {
          "name": "Batch across accounts",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 202\", () => pm.response.to.have.status(202));",
                  "pm.test(\"4 queued\", () => pm.expect(pm.response.json().data.queued).to.eql(4));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ingest/batch",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ingest",
                "batch"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"events\": [\n    {\n      \"account_id\": \"acc_acme\",\n      \"event_name\": \"signup\",\n      \"timestamp\": \"2026-09-01T11:00:00Z\"\n    },\n    {\n      \"account_id\": \"acc_globex\",\n      \"event_name\": \"login\",\n      \"timestamp\": \"2026-09-01T11:01:00Z\"\n    },\n    {\n      \"account_id\": \"acc_hooli\",\n      \"event_name\": \"purchase\",\n      \"timestamp\": \"2026-09-01T11:02:00Z\"\n    },\n    {\n      \"account_id\": \"acc_hooli\",\n      \"event_name\": \"logout\",\n      \"timestamp\": \"2026-09-01T11:03:00Z\"\n    }\n  ]\n}"
            },
            "description": "Counts once against each account's batch allowance."
          }
        },
        {
          "name": "Batch of 100 (maximum)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
