NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://nango:nango@localhost:5432/nango?schema=public
EVENTS_DEFAULT_LIMIT=100
EVENTS_MAX_LIMIT=1000
INGEST_RATE_LIMIT_PER_MINUTE=100
ACCOUNT_CACHE_TTL_SECONDS=300     # how long a known account_id stays cached (misses are cached for 30s)
REDIS_URL=redis://localhost:6379   # optional; counters are in-memory when unset
SLACK_BOT_TOKEN=                   # Slack bot token (xoxb-…, chat:write scope, bot invited to #superday-rob); read by docker compose into Grafana's contact point
LOG_LEVEL=info   # debug | info | warn | error | silent
